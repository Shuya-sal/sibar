# SIBAR Apache Security Configuration
# Proteksi Server-Level terhadap Berbagai Serangan Siber

# 1. Matikan Directory Browsing
Options -Indexes

# 2. Blokir Akses Langsung ke File Basis Data & File Sensitif
<FilesMatch "\.(db|sqlite|sqlite3|sql|log|ini|env|json|bak|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir Akses ke Direktori Git & Konfigurasi
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git - [F,L]
    RewriteRule ^data/ - [F,L]
</IfModule>

# 4. Tambahkan Header Keamanan jika mod_headers aktif
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# 5. Force HTTPS (HSTS) — aktifkan saat di server HTTPS
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\. [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 6. HSTS Header (1 tahun, termasuk subdomain)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# 7. Cegah Path Traversal — blokir request dengan ../ atau %2e
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} \.\.[/\\] [NC,OR]
    RewriteCond %{QUERY_STRING} %2e%2e [NC,OR]
    RewriteCond %{REQUEST_URI} \.\.[/\\] [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 8. Blokir User-Agent Kosong & Scanner Otomatis
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} (nikto|sqlmap|havij|masscan|nessus|nmap|burpsuite|metasploit|acunetix|w3af|dirbuster|hydra|medusa) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 9. Batasi Ukuran Request (Anti-Upload Bomb / DoS)
LimitRequestBody 5242880

# 10. Nonaktifkan Method HTTP Berbahaya
<LimitExcept GET POST>
    Require all denied
</LimitExcept>

# 11. Sembunyikan versi Apache
ServerSignature Off
