# SIBAR Apache Security Configuration
# Proteksi Server-Level terhadap Berbagai Serangan Siber

# 1. Matikan Directory Browsing
Options -Indexes

# 2. Blokir Akses Langsung ke File Basis Data & File Sensitif
<FilesMatch "\.(db|sqlite|sqlite3|sql|log|ini|env|json|bak|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir Akses ke Direktori Git & Konfigurasi
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git - [F,L]
    RewriteRule ^data/ - [F,L]
</IfModule>

# 4. Tambahkan Header Keamanan jika mod_headers aktif
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>
